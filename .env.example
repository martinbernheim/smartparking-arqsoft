# Copiar a .env (cp .env.example .env). Valores de DEMO, no usar en producción.

# --- Identity Service ---
IDENTITY_PORT=3001
JWT_ISSUER=smartparking-identity
JWT_EXPIRES_IN=3600
BCRYPT_ROUNDS=10
LOG_LEVEL=info

# Seed (idempotente al arrancar Identity)
SEED_ADMIN_EMAIL=admin@smartparking.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CLIENT1_EMAIL=cliente1@smartparking.local
SEED_CLIENT1_PASSWORD=Cliente123!
SEED_CLIENT2_EMAIL=cliente2@smartparking.local
SEED_CLIENT2_PASSWORD=Cliente123!
# ObjectIds fijos de los clientes demo: el seed de la API (Cliente.identityUserId)
# debe usar estos mismos valores para vincular cada Cliente con su usuario de Identity.
SEED_CLIENT1_ID=650000000000000000000001
SEED_CLIENT2_ID=650000000000000000000002

# --- MongoDB (Identity DB) ---
MONGO_PORT=27017
MONGO_URL=mongodb://mongo:27017/identity

# --- PostgreSQL (Operational DB) ---
POSTGRES_USER=smartparking
POSTGRES_PASSWORD=smartparking
POSTGRES_DB=smartparking
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator
DATABASE_URL=postgresql://smartparking:smartparking@postgres:5432/smartparking
# Por defecto la réplica apunta a la primaria; con el perfil "replica" usar postgres-replica:5432
DATABASE_REPLICA_URL=postgresql://smartparking:smartparking@postgres:5432/smartparking

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=30

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# H2/H3: solo existe el adapter "log" (Winston). "rabbitmq" llega en H4 (hasta entonces cae a "log").
AUDIT_PUBLISHER=log
AUDIT_EXCHANGE=smartparking.events
AUDIT_QUEUE=audit-log
AUDIT_RETRY_MAX=5
AUDIT_PREFETCH=20

# --- Elasticsearch / Kibana ---
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX=audit-events
KIBANA_PORT=5601

# --- API ---
API_PORT=3002
# --- Nginx (hito posterior) ---
IDENTITY_BASE_URL=http://identity-service:3001
JWKS_URL=http://identity-service:3001/.well-known/jwks.json
NGINX_PORT=8080
